#!/usr/bin/env bash
# Apply one binding to the user's bindings.lua.
#
# Usage:
#   keysmith-write <newCanonicalKey> <oldCanonicalKey|''> <label> <actionText> [--replace]
#   keysmith-write remove <currentCanonicalKey> <label> <actionText>
#
# oldCanonicalKey is empty for an app or removed action that is not bound yet.
# For an existing binding it is the key currently owning the selected action;
# moving that action must unbind the old key, not merely add a second shortcut.
# Remove updates the same action-owned block and emits unbinds without a bind;
# it leaves the action unbound instead of restoring a packaged default.
#
# Exit codes:
#   0  written and verified
#   2  new combo is taken by another binding and --replace was not given
#   3  new config error, change rolled back and runtime restored
#   4  rollback did not restore the baseline - needs a human
#   5  Hyprland state could not be read (nothing written)
#   6  reload/verification failed, change rolled back and runtime restored
#
# Three rules drive the shape of this file:
#
#   A rebind is a MOVE. Emitting only the new bind leaves the old key working
#   too, which is an extra shortcut, not a rebind.
#
#   A non-empty `hyprctl configerrors` does not mean WE broke something. The
#   file may have been broken before Keysmith touched it, and rolling back a
#   correct change because of someone else's error is its own bug. So compare
#   against a baseline taken before writing, never against "is it empty".
#
#   Restoring bytes on disk does not undo what Hyprland already loaded. A
#   failed write must reload a SECOND time, or the file ends up correct while
#   the live session stays wrong - which looks like success and is not.
set -uo pipefail

export LC_ALL=C

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
KEYS="$HERE/keysmith-keys"
SAFE_FILE="$HERE/keysmith-file"
BINDINGS="${KEYSMITH_BINDINGS:-$HOME/.config/hypr/bindings.lua}"
HYPRCTL="${KEYSMITH_HYPRCTL:-hyprctl}"
MAX_BINDINGS_BYTES=4194304
MAX_CONFIGERROR_BYTES=1048576
HYPR_TIMEOUT=3

mode=set
if [[ ${1:-} == remove ]]; then
  mode=remove
  key=""
  old_key="${2:?current canonical key}"
  label="${3:?label}"
  action="${4:?action text}"
else
  key="${1:?new canonical key}"
  old_key="${2-}"
  label="${3:?label}"
  action="${4:?action text}"
fi
replace=0
[[ $mode == set && "${5:-}" == "--replace" ]] && replace=1

if (( ${#key} > 256 || ${#old_key} > 256 || ${#label} > 1024 || ${#action} > 8192 )); then
  echo "keysmith: input field exceeds the write limit - nothing written" >&2
  exit 5
fi

work=$(mktemp -d) || exit 5
chmod 700 "$work" || exit 5
backup="$work/original"
candidate="$work/candidate"
catalog_file="$work/catalog.json"
trap 'rm -rf -- "$work"' EXIT

phase=baseline
reload_count=0

# Test seams. They exist so the rollback paths can be exercised without
# breaking a real config; in normal use none of these are set.
configerrors() {
  case "$phase" in
    baseline) [[ -n ${KEYSMITH_FAKE_BASELINE+x} ]] && { printf '%s' "$KEYSMITH_FAKE_BASELINE"; return; } ;;
    after)    [[ -n ${KEYSMITH_FAKE_AFTER+x} ]] && { printf '%s' "$KEYSMITH_FAKE_AFTER"; return; } ;;
    restored)
      [[ -n ${KEYSMITH_FAKE_RESTORED+x} ]] && { printf '%s' "$KEYSMITH_FAKE_RESTORED"; return; }
      [[ -n ${KEYSMITH_FAKE_BASELINE+x} ]] && { printf '%s' "$KEYSMITH_FAKE_BASELINE"; return; }
      ;;
  esac

  local output_file="$work/configerrors.$phase" size
  timeout --foreground --kill-after=1s "${HYPR_TIMEOUT}s" \
    "$HYPRCTL" configerrors 2>/dev/null |
    head -c "$((MAX_CONFIGERROR_BYTES + 1))" >"$output_file"
  local statuses=("${PIPESTATUS[@]}")
  size=$(wc -c <"$output_file") || return 1
  (( size <= MAX_CONFIGERROR_BYTES )) || return 1
  (( statuses[0] == 0 && statuses[1] == 0 )) || return 1
  awk 'NF' "$output_file"
}

reload() {
  if [[ -n ${KEYSMITH_RELOAD_LOG:-} ]]; then
    printf 'reload\n' >>"$KEYSMITH_RELOAD_LOG" || return 1
  fi
  reload_count=$((reload_count + 1))
  if [[ ${KEYSMITH_FAKE_RELOAD_FAIL_AT:-0} == "$reload_count" ]]; then
    return 1
  fi
  [[ ${KEYSMITH_DRYRUN:-0} == 1 ]] && return 0
  timeout --foreground --kill-after=1s "${HYPR_TIMEOUT}s" \
    "$HYPRCTL" reload >/dev/null 2>&1
}

is_taken() {
  if [[ -n ${KEYSMITH_TAKEN+x} ]]; then
    [[ -n $KEYSMITH_TAKEN && $KEYSMITH_TAKEN == "$key" ]] && return 0
    return 1
  fi

  local status
  if ! timeout --foreground --kill-after=1s 15s \
      "$HERE/keysmith-read" >"$catalog_file" 2>/dev/null; then
    return 2
  fi
  jq -e --arg k "$key" 'any(.[]; .key == $k)' "$catalog_file" >/dev/null 2>&1
  status=$?
  [[ $status == 0 ]] && return 0
  [[ $status == 1 ]] && return 1
  return 2
}

# A selected binding already owns old_key. Capturing the same key is therefore
# not a conflict with "another" binding. Any other taken destination requires
# an explicit replace decision.
if [[ $mode == set ]]; then
  is_taken
  taken=$?
  if (( taken == 2 )); then
    echo "keysmith: unable to read current bindings - nothing written" >&2
    exit 5
  fi
  if (( taken == 0 )) && [[ "$key" != "$old_key" ]] && (( ! replace )); then
    echo "taken: $key" >&2
    exit 2
  fi
fi

if ! baseline=$(configerrors); then
  echo "keysmith: unable to read Hyprland config errors - nothing written" >&2
  exit 5
fi

# Resolve all key spellings before creating or touching the target file.
write_key=""
if [[ $mode == set ]] && ! write_key=$("$KEYS" spell "$key"); then
  echo "keysmith: unsupported destination key - nothing written" >&2
  exit 5
fi
old_write_key=""
if [[ -n "$old_key" ]] && ! old_write_key=$("$KEYS" spell "$old_key"); then
  echo "keysmith: unsupported old key - nothing written" >&2
  exit 5
fi

if ! metadata=$("$SAFE_FILE" snapshot "$BINDINGS" "$backup" "$MAX_BINDINGS_BYTES"); then
  echo "keysmith: unsafe or unreadable bindings file - nothing written" >&2
  exit 5
fi
if ! jq -e '
    (.exists | type) == "boolean"
    and (.sha256 | type) == "string"
    and (.sha256 | test("^[0-9a-f]{64}$"))
    and (.mode | type) == "string"
    and (.mode | test("^[0-7]{3}$"))
    and (.mtimeNs | type) == "string"
    and (.mtimeNs | test("^(-|[0-9]+)$"))
  ' <<<"$metadata" >/dev/null; then
  echo "keysmith: invalid file snapshot - nothing written" >&2
  exit 5
fi
if [[ $(jq -r '.exists' <<<"$metadata") == true ]]; then
  existed=1
  expected_hash=$(jq -r '.sha256' <<<"$metadata")
  original_mtime=$(jq -r '.mtimeNs' <<<"$metadata")
else
  existed=0
  expected_hash=missing
  original_mtime=-
fi
file_mode=$(jq -r '.mode' <<<"$metadata")

# The action identity is stable across Add, Change, and Remove. A matching
# owned block can therefore be replaced in place instead of stacking an
# unbounded history of overrides. Label participates because two described
# actions may deliberately run the same command.
if ! identity=$(jq -cn --arg label "$label" --arg action "$action" '[$label, $action]'); then
  exit 5
fi
id=$(printf '%s' "$identity" | sha256sum | cut -c1-12)
[[ -n $id ]] || exit 5
begin_marker="-- keysmith:begin $id"
end_marker="-- keysmith:end $id"

begin_count=$(grep -cFx -- "$begin_marker" "$backup")
end_count=$(grep -cFx -- "$end_marker" "$backup")
if (( begin_count != end_count || begin_count > 1 )); then
  echo "keysmith: malformed owned block $id - nothing written" >&2
  exit 5
fi

disabled_json='[]'
prior_current=""
if (( begin_count == 1 )); then
  if ! encoded=$(awk -v begin="$begin_marker" -v end="$end_marker" '
      $0 == begin { inside=1; next }
      $0 == end { inside=0 }
      inside && /^-- keysmith:data / {
        sub(/^-- keysmith:data /, "")
        print
        found++
      }
      END { if (found != 1) exit 1 }
    ' "$backup"); then
    echo "keysmith: owned block $id has no valid state - nothing written" >&2
    exit 5
  fi
  if ! state_json=$(printf '%s' "$encoded" | base64 --decode 2>/dev/null); then
    echo "keysmith: owned block $id has invalid state - nothing written" >&2
    exit 5
  fi
  if ! jq -e --arg label "$label" --arg action "$action" '
      .v == 1
      and .label == $label
      and .action == $action
      and (.currentKey | type) == "string"
      and (.state == "bound" or .state == "removed")
      and (.currentKey | utf8bytelength) <= 256
      and (.disabledKeys | type) == "array"
      and (.disabledKeys | length) <= 256
      and all(.disabledKeys[]; type == "string" and length > 0 and utf8bytelength <= 256)
    ' <<<"$state_json" >/dev/null; then
    echo "keysmith: owned block $id has invalid state - nothing written" >&2
    exit 5
  fi
  disabled_json=$(jq -c '.disabledKeys' <<<"$state_json") || exit 5
  prior_current=$(jq -r '.currentKey' <<<"$state_json") || exit 5
fi

add_disabled() {
  local disabled_key="$1"
  [[ -z $disabled_key ]] && return 0
  disabled_json=$(jq -c --arg key "$disabled_key" '. + [$key] | unique' <<<"$disabled_json") || exit 5
}

# Retain every key this action-owned state disabled before. Removing an older
# block must never let a packaged default or previously replaced destination
# spring back unexpectedly.
add_disabled "$prior_current"
add_disabled "$old_key"
if [[ $mode == set ]] && (( replace )); then
  add_disabled "$key"
fi
if ! jq -e 'length <= 256' <<<"$disabled_json" >/dev/null; then
  echo "keysmith: owned block has too many disabled keys - nothing written" >&2
  exit 5
fi

current_key=""
state=removed
if [[ $mode == set ]]; then
  current_key="$key"
  state=bound
fi

if ! state_json=$(jq -cn \
    --arg label "$label" --arg action "$action" --arg current "$current_key" \
    --arg state "$state" --argjson disabled "$disabled_json" \
    '{v: 1, label: $label, action: $action, currentKey: $current,
      state: $state, disabledKeys: $disabled}'); then
  exit 5
fi
state_encoded=$(printf '%s' "$state_json" | base64 -w0) || exit 5

disabled_write_keys=()
while IFS= read -r disabled_key; do
  [[ -z $disabled_key ]] && continue
  if ! disabled_write_key=$("$KEYS" spell "$disabled_key"); then
    echo "keysmith: unsupported stored key - nothing written" >&2
    exit 5
  fi
  disabled_write_keys+=("$disabled_write_key")
done < <(jq -r '.[]' <<<"$disabled_json")

# label is data inside a Lua string; do not let a quote or backslash turn it
# into Lua syntax. action is deliberately opaque Lua and is emitted verbatim.
safe_label=${label//\\/\\\\}
safe_label=${safe_label//\"/\\\"}
safe_label=${safe_label//$'\n'/\\n}
safe_label=${safe_label//$'\r'/\\r}

# Copy every user-owned byte around the matching block. Byte offsets avoid a
# line-oriented rewrite that could normalize unrelated whitespace or a missing
# final newline. The one separator newline Keysmith added is replaced too.
if (( begin_count == 1 )); then
  begin_offset=$(LC_ALL=C grep -aboF -- "$begin_marker" "$backup" | head -1 | cut -d: -f1)
  end_offset=$(LC_ALL=C grep -aboF -- "$end_marker" "$backup" | head -1 | cut -d: -f1)
  file_size=$(stat -c %s "$backup") || exit 5
  remove_start=$begin_offset
  (( remove_start > 0 )) && remove_start=$((remove_start - 1))
  remove_end=$((end_offset + ${#end_marker}))
  (( remove_end < file_size )) && remove_end=$((remove_end + 1))
  : >"$candidate" || exit 5
  if (( remove_start > 0 )); then
    dd if="$backup" of="$candidate" bs=1 count="$remove_start" status=none || exit 5
  fi
  if (( remove_end < file_size )); then
    dd if="$backup" of="$candidate" bs=1 skip="$remove_end" seek="$remove_start" conv=notrunc status=none || exit 5
  fi
else
  cp -- "$backup" "$candidate" || exit 5
fi

published=0
published_hash=""

restore_file() {
  if (( existed )); then
    "$SAFE_FILE" replace "$BINDINGS" "$backup" "$published_hash" \
      "$file_mode" "$original_mtime" "$MAX_BINDINGS_BYTES"
  else
    "$SAFE_FILE" remove "$BINDINGS" "$published_hash" "$MAX_BINDINGS_BYTES"
  fi
}

rollback() {
  local exit_code="$1" message="$2" restored
  if (( ! published )); then
    echo "$message: nothing written" >&2
    exit "$exit_code"
  fi
  if ! restore_file || ! reload; then
    echo "ROLLBACK INCOMPLETE - inspect $BINDINGS by hand" >&2
    exit 4
  fi
  phase=restored
  if ! restored=$(configerrors); then
    echo "ROLLBACK INCOMPLETE - could not verify $BINDINGS" >&2
    exit 4
  fi
  if [[ "$restored" == "$baseline" ]]; then
    echo "$message: $BINDINGS" >&2
    exit "$exit_code"
  fi
  echo "ROLLBACK INCOMPLETE - inspect $BINDINGS by hand" >&2
  exit 4
}

if ! {
  printf '\n-- keysmith:begin %s\n' "$id"
  printf '%s\n' "-- keysmith:data $state_encoded"
  for disabled_write_key in "${disabled_write_keys[@]}"; do
    printf 'hl.unbind("%s")\n' "$disabled_write_key"
  done
  if [[ $mode == set ]]; then
    printf 'o.bind("%s", "%s", %s)\n' "$write_key" "$safe_label" "$action"
  fi
  printf -- '-- keysmith:end %s\n' "$id"
} >>"$candidate"; then
  rollback 6 "write failed, restored"
fi

published_hash=$(sha256sum "$candidate" | cut -d' ' -f1)
[[ $published_hash =~ ^[0-9a-f]{64}$ ]] || rollback 6 "write failed"
if ! "$SAFE_FILE" replace "$BINDINGS" "$candidate" "$expected_hash" \
    "$file_mode" - "$MAX_BINDINGS_BYTES"; then
  rollback 6 "write failed"
fi
published=1

if ! reload; then
  rollback 6 "reload failed, restored"
fi
phase=after
if ! after=$(configerrors); then
  rollback 6 "verification failed, restored"
fi

if [[ "$after" == "$baseline" ]]; then
  echo "$id"
  exit 0
fi

rollback 3 "rolled back"
