{
  "schemaVersion": 1,
  "id": "sinkeat.keysmith",
  "name": "Keysmith",
  "version": "0.1.0",
  "author": "Ahmed-Sinkeat",
  "license": "MIT",
  "description": "Add, change, and remove Omarchy shortcuts without editing config files",
  "kinds": ["overlay", "bar-widget"],
  "entryPoints": {
    "overlay": "Keysmith.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Keysmith",
    "description": "Open the shortcut manager",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
