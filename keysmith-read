#!/usr/bin/env bash
# Emit the Keysmith catalog as a JSON array on stdout. Read-only.
#
# Three sources, three tiers:
#   hyprctl binds  -> authoritative map of what combos are TAKEN
#   packaged Lua   -> verbatim action text, the only place it exists
#   .desktop files -> apps that have no binding yet
#
# Actions cannot come from hyprctl: under Quattro every bind reports
# `dispatcher: __lua` with an opaque callback handle.
set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
KEYS="$HERE/keysmith-keys"
OMARCHY="${OMARCHY_PATH:-/usr/share/omarchy}"
USER_BINDINGS="${KEYSMITH_BINDINGS:-$HOME/.config/hypr/bindings.lua}"
HYPRCTL="${KEYSMITH_HYPRCTL:-hyprctl}"

# --- 1. taken combos -> "canonical<TAB>description" -----------------------
binds_tsv() {
  local raw
  if ! raw=$("$HYPRCTL" binds 2>/dev/null); then
    echo "keysmith: unable to read Hyprland bindings" >&2
    return 1
  fi

  printf '%s\n' "$raw" | awk '
    function flush() {
      if (!seen) return; seen = 0
      printf "%s\t%s\t%s\n", f["modmask"], f["key"], f["description"]
    }
    /^bind/ { flush(); seen = 1; delete f; next }
    seen && match($0, /^\t[a-z]+: /) { f[substr($0, 2, RLENGTH - 3)] = substr($0, RLENGTH + 1) }
    END { flush() }
  ' | while IFS=$'\t' read -r mask key desc; do
      [[ -z ${key:-} ]] && continue
      # Some rows repeat the modifiers inside the key field, e.g.
      # modmask=64 key="SUPER + code:10". modmask is authoritative, so keep
      # only the final segment as the key. Dropping these rows entirely would
      # hide every workspace binding from the conflict map.
      key="${key##* + }"
      canon=$("$KEYS" hypr "$mask" "$key" 2>/dev/null) || continue
      printf '%s\t%s\n' "$canon" "${desc:-}"
    done
}

# --- 2. action text -> "canonical<TAB>description<TAB>action" -------------
# Only single-line o.bind calls. Loop-generated and multi-line calls are
# deliberately unmatched: half-parsing them is worse than declaring them
# non-rebindable.
lua_tsv() {
  local files=()
  shopt -s nullglob
  files=("$OMARCHY"/default/hypr/bindings/*.lua)
  shopt -u nullglob
  [[ -f $USER_BINDINGS ]] && files+=("$USER_BINDINGS")
  ((${#files[@]} > 0)) || return 0

  cat -- "${files[@]}" |
    sed -nE 's/^[[:space:]]*o\.bind\("([^"]*)"[[:space:]]*,[[:space:]]*"([^"]*)"[[:space:]]*,[[:space:]]*(.*)\)[[:space:]]*$/\1\t\2\t\3/p' |
    while IFS=$'\t' read -r key desc action; do
      [[ -z ${key:-} || -z ${action:-} ]] && continue
      canon=$("$KEYS" lua "$key" 2>/dev/null) || continue
      printf '%s\t%s\t%s\n' "$canon" "$desc" "$action"
    done
}

# --- 3. installed apps -> "name<TAB>exec" ---------------------------------
apps_tsv() {
  for d in /usr/share/applications "$HOME/.local/share/applications"; do
    [[ -d $d ]] || continue
    for f in "$d"/*.desktop; do
      [[ -f $f ]] || continue
      grep -qi '^NoDisplay=true' "$f" && continue
      grep -qi '^Type=Application' "$f" || continue
      name=$(sed -n 's/^Name=//p' "$f" | head -1)
      exec_=$(sed -n 's/^Exec=//p' "$f" | head -1 | sed 's/ *%[a-zA-Z]//g')
      [[ -z ${name:-} || -z ${exec_:-} ]] && continue
      printf '%s\t%s\n' "$name" "$exec_"
    done
  done | sort -u -t$'\t' -k1,1
}

live_bindings=$(binds_tsv) || exit 1
action_definitions=$(lua_tsv) || { echo "keysmith: unable to read binding actions" >&2; exit 1; }
desktop_apps=$(apps_tsv)

jq -n --arg binds "$live_bindings" --arg actions "$action_definitions" --arg apps "$desktop_apps" '
  def tsv_rows($text):
    $text | split("\n") | map(select(length > 0) | split("\t"));

  def action_words($action):
    [($action // "" | ascii_downcase) | splits("[^A-Za-z0-9_.+-]+")];

  # Prefer an exact display-name match. It identifies wrappers and webapps
  # whose shared launcher executable cannot distinguish one desktop entry from
  # another. Fall back to the executable basename for differently named rows.
  def matching_apps($row; $apps):
    ($apps | map(select(
      (.label | ascii_downcase) == ($row.label | ascii_downcase)
    ))) as $nameMatches
    | if ($nameMatches | length) > 0 then $nameMatches
      else ($apps | map(
        . as $app
        | select(
            $app.base != ""
            and (action_words($row.action) | index($app.base)) != null
          )
      ))
      end;

  (tsv_rows($actions)) as $actionDefinitions

  # A key may legitimately own more than one action: ALT+TAB has two press
  # actions and F9 has distinct press/release actions. Match the description
  # so the catalog still reports the correct action. Such rows are deliberately
  # non-rebindable, though: hl.unbind accepts only a key and would remove every
  # sibling action while Keysmith moved just the selected one.
  | (tsv_rows($binds)) as $liveBindings
  | ($liveBindings | map(
      . as $bind
      | ($liveBindings | map(select(.[0] == $bind[0]))) as $liveByKey
      | ($actionDefinitions | map(select(.[0] == $bind[0]))) as $byKey
      | ($byKey | map(select(.[1] == ($bind[1] // "")))) as $byDescription
      | (if ($byDescription | length) == 1 then $byDescription[0][2]
         elif ($byKey | length) == 1 then $byKey[0][2]
         else null
         end) as $action
      | {
          label:      (if ($bind[1] // "") == "" then $bind[0] else $bind[1] end),
          key:        $bind[0],
          source:     "binding",
          action:     $action,
          rebindable: ($action != null and ($liveByKey | length) == 1)
        }
    )) as $bindingRows

  # Definitions still present in Lua but absent from the live binding map are
  # actions with no shortcut. This is how a removed default remains searchable
  # and can be Added again later. Identity is label+opaque action, matching the
  # the stable owned-block identity used by the writer.
  | ($actionDefinitions
    | unique_by([.[1], .[2]])
    | map(
        . as $definition
        | select(
            ($bindingRows | any(
              .label == (if ($definition[1] // "") == "" then $definition[0] else $definition[1] end)
              and .action == $definition[2]
            )) | not
          )
        | {
            label:      (if (.[1] // "") == "" then .[0] else .[1] end),
            key:        null,
            source:     "action",
            action:     .[2],
            rebindable: true
          }
      )) as $unboundActions

  | (tsv_rows($apps) | map({
      _appId:     ([.[0], .[1]] | @json),
      label:      .[0],
      key:        null,
      source:     "app",
      # Exec is arbitrary text from a .desktop file and goes inside a Lua
      # string. @json quotes and escapes it; hand-built quotes let an Exec
      # containing " or \ emit Lua that does not parse.
      action:     ("{ launch = " + (.[1] | @json) + " }"),
      rebindable: true,
      base:       (.[1] | split(" ")[0] | split("/") | last | ascii_downcase)
    })) as $desktopApps

  # Merge a desktop app into its live or removed action row. `identityLabel`
  # preserves the original Lua description for the stable writer block id;
  # `label` becomes the app name users expect to search for and see.
  | (($bindingRows + $unboundActions) | map(
      . as $row
      | matching_apps($row; $desktopApps) as $matches
      | if ($matches | length) == 1 then
          . + {
            identityLabel: .label,
            label: $matches[0].label,
            _matchedAppId: $matches[0]._appId
          }
        else .
        end
    )) as $catalogRows

  | ($desktopApps | map(
      . as $app
      | select(($catalogRows | any(._matchedAppId? == $app._appId)) | not)
      | del(.base, ._appId)
    )) as $unboundApps

  | ($catalogRows | map(del(._matchedAppId))) + $unboundApps
'
